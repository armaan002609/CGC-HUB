generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ------------------------------------------------------
// NEXTAUTH MODELS
// ------------------------------------------------------
model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ------------------------------------------------------
// USER MODEL
// ------------------------------------------------------
enum Role {
  STUDENT
  FACULTY
  MODERATOR
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  
  // Custom Fields
  role          Role      @default(STUDENT)
  department    String?
  ssoId         String?   @unique

  // Relations
  accounts         Account[]
  sessions         Session[]
  playerProfile    PlayerProfile?
  dutyAssignments  DutyAssignment[]
  reports          EventReport[]
  mediaAssets      MediaAsset[]
  registrations    TeamMember[]
  managedSportsEvents SportsEvent[] @relation("EventManagers")
}

// ------------------------------------------------------
// SPORTS MODULE
// ------------------------------------------------------
enum PlayerType {
  STUDENT
  FACULTY
}

model PlayerProfile {
  id         String     @id @default(cuid())
  userId     String     @unique
  department String?
  sports     String[]
  type       PlayerType @default(STUDENT)
  stats      Json?      // Store flexible stats like { goals: 5, matches: 10 }
  bio        String?

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum EventStatus {
  UPCOMING
  LIVE
  COMPLETED
}

model SportsEvent {
  id             String       @id @default(cuid())
  title          String
  sport          String
  teams          String[]     // e.g., ["CSE", "ECE"] or specific team names
  schedule       DateTime
  venue          String
  status         EventStatus  @default(UPCOMING)
  liveScoreState Json?        // e.g., { teamA: 2, teamB: 1, currentSet: 1 }

  managers       User[]       @relation("EventManagers")
  mediaAssets    MediaAsset[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

enum MedalType {
  GOLD
  SILVER
  BRONZE
}

model MedalLedger {
  id         String    @id @default(cuid())
  year       Int
  event      String    // e.g., "Inter-Department Basketball 2024"
  sport      String
  winnerType String    // "INDIVIDUAL" or "TEAM"
  winnerRefs String[]  // User IDs or Team Names
  medal      MedalType
  trophyName String?

  createdAt  DateTime  @default(now())
}

// ------------------------------------------------------
// CULTURAL MODULE
// ------------------------------------------------------
model CulturalEvent {
  id          String           @id @default(cuid())
  title       String
  description String?
  schedule    DateTime
  venue       String
  status      EventStatus      @default(UPCOMING)

  assignments DutyAssignment[]
  reports     EventReport[]
  mediaAssets MediaAsset[]

  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model DutyAssignment {
  id              String        @id @default(cuid())
  eventId         String
  userId          String
  role            String        // e.g., "Coordinator", "Volunteer", "Security"
  shiftStart      DateTime
  shiftEnd        DateTime
  checkInTime     DateTime?
  checkOutTime    DateTime?

  event           CulturalEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model EventReport {
  id              String        @id @default(cuid())
  eventId         String
  summary         String
  attendanceCount Int           @default(0)
  outcomes        String?
  publishedById   String

  event           CulturalEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  publishedBy     User          @relation(fields: [publishedById], references: [id], onDelete: SetNull)
  publishedAt     DateTime      @default(now())
}

// ------------------------------------------------------
// HACKATHON MODULE
// ------------------------------------------------------
enum RegistrationStatus {
  PENDING
  CONFIRMED
  WAITLISTED
}

model Hackathon {
  id                  String         @id @default(cuid())
  title               String
  description         String
  registrationOpen    DateTime
  registrationClose   DateTime
  eventStartDate      DateTime
  eventEndDate        DateTime
  resultsDate         DateTime?
  status              EventStatus    @default(UPCOMING)

  registrations       Registration[]
  mediaAssets         MediaAsset[]

  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
}

model Registration {
  id                   String             @id @default(cuid())
  hackathonId          String
  teamName             String
  eligibilityConfirmed Boolean            @default(false)
  status               RegistrationStatus @default(PENDING)
  submittedAt          DateTime           @default(now())

  hackathon            Hackathon          @relation(fields: [hackathonId], references: [id], onDelete: Cascade)
  members              TeamMember[]
  submission           Submission?
}

model TeamMember {
  id             String       @id @default(cuid())
  registrationId String
  userId         String
  isLeader       Boolean      @default(false)

  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([registrationId, userId])
}

model Submission {
  id             String       @id @default(cuid())
  registrationId String       @unique
  projectTitle   String
  description    String
  repoUrl        String?
  score          Float?
  rank           Int?

  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  mediaAssets    MediaAsset[]
  
  submittedAt    DateTime     @default(now())
}

// ------------------------------------------------------
// SHARED MEDIA ASSETS
// ------------------------------------------------------
enum MediaType {
  IMAGE
  VIDEO
  DOCUMENT
}

model MediaAsset {
  id              String         @id @default(cuid())
  type            MediaType
  url             String
  uploadedById    String?

  // Polymorphic-like relations (only one of these will be non-null)
  sportsEventId   String?
  culturalEventId String?
  hackathonId     String?
  submissionId    String?

  uploadedBy      User?          @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  sportsEvent     SportsEvent?   @relation(fields: [sportsEventId], references: [id], onDelete: Cascade)
  culturalEvent   CulturalEvent? @relation(fields: [culturalEventId], references: [id], onDelete: Cascade)
  hackathon       Hackathon?     @relation(fields: [hackathonId], references: [id], onDelete: Cascade)
  submission      Submission?    @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  createdAt       DateTime       @default(now())
}

// ------------------------------------------------------
// HOMEPAGE HIGHLIGHTS
// ------------------------------------------------------
model GalleryHighlight {
  id        String    @id @default(cuid())
  title     String
  tag       String
  type      MediaType
  url       String
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
}

model HeroBanner {
  id        String   @id @default(cuid())
  url       String
  title     String?
  isActive  Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
